# ========================================
# SIPp Web Manager - 主机节点配置示例
# ========================================
# 复制此文件为 .env 并修改配置

# ------------------
# 节点配置
# ------------------
NODE_ROLE=master
MACHINE_ID=master
MACHINE_NAME=主控节点

# ------------------
# 服务器配置
# ------------------
PORT=3000
NODE_ENV=production

# ------------------
# 数据库配置（MySQL）
# ------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sipp_manager
DB_USER=sipp
DB_PASSWORD=sipp123456
DB_POOL_SIZE=10

# ------------------
# SIPp 配置
# ------------------
SIPP_HOST=localhost
SIPP_CONTROL_PORT=8888
SIPP_SCENARIO_DIR=/opt/sipp-web-manager/scenarios
SIPP_INJECTION_DIR=/opt/sipp-web-manager/injections
SIPP_LOG_DIR=/opt/sipp-web-manager/logs

# ------------------
# WebSocket 配置
# ------------------
WS_PORT=3000
WS_CORS_ORIGIN=*

# ------------------
# 日志配置
# ------------------
LOG_LEVEL=info
LOG_FILE=/opt/sipp-web-manager/logs/app.log

# ------------------
# 心跳配置（主机不需要）
# ------------------
# HEARTBEAT_INTERVAL=10000
