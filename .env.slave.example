# ========================================
# SIPp Web Manager - 从机节点配置示例
# ========================================
# 复制此文件为 .env 并修改配置

# ------------------
# 节点配置
# ------------------
NODE_ROLE=slave
MACHINE_ID=slave-01
MACHINE_NAME=测试节点01

# ------------------
# 服务器配置
# ------------------
PORT=3000
NODE_ENV=production

# ------------------
# 主机连接配置（心跳通过HTTP API上报）
# ------------------
MASTER_HOST=192.168.1.100
MASTER_PORT=3000

# ------------------
# 数据库配置（连接到主机的数据库）
# 说明：从机仍需数据库连接用于任务历史记录和恢复
#      但心跳/注册信息通过上方的MASTER_HOST API上报
# ------------------
DB_HOST=192.168.1.100
DB_PORT=3306
DB_NAME=sipp_manager
DB_USER=sipp
DB_PASSWORD=sipp123456
DB_POOL_SIZE=5

# ------------------
# SIPp 配置
# ------------------
SIPP_HOST=localhost
SIPP_CONTROL_PORT=8888
SIPP_SCENARIO_DIR=/opt/sipp-web-manager/scenarios
SIPP_INJECTION_DIR=/opt/sipp-web-manager/injections
SIPP_LOG_DIR=/opt/sipp-web-manager/logs

# ------------------
# 心跳配置
# ------------------
HEARTBEAT_INTERVAL=10000

# ------------------
# 日志配置
# ------------------
LOG_LEVEL=info
LOG_FILE=/opt/sipp-web-manager/logs/app.log
