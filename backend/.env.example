# SIPp Web Manager - 后端配置模板
# 请根据实际情况修改配置，或运行 deploy.sh 自动生成

# ============================================
# 节点信息
# ============================================
# 节点角色：master（主控节点）或 slave（从机节点）
NODE_ROLE=master

# 机器唯一标识（从机会自动生成）
MACHINE_ID=master

# 机器显示名称
MACHINE_NAME=主控节点

# ============================================
# 服务端口配置
# ============================================
# 后端服务监听端口
PORT=3000

# ============================================
# 数据库配置
# ============================================
# 数据库主机地址
# - 主机模式：通常为 localhost 或 127.0.0.1
# - 从机模式：填写主机的 IP 地址
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库名称
DB_NAME=sipp_manager

# 数据库用户名
DB_USER=root

# 数据库密码（如无密码留空）
DB_PASSWORD=

# 数据库连接池大小
# - 主机：建议 10
# - 从机：建议 5
DB_POOL_SIZE=10

# ============================================
# 主机连接配置（仅从机模式需要）
# ============================================
# 主机地址（从机连接主机使用）
# MASTER_HOST=192.168.1.100

# 主机服务端口
# MASTER_PORT=3000

# ============================================
# 日志配置
# ============================================
# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# ============================================
# 文件目录配置（相对于项目根目录）
# ============================================
# SIPp 场景文件目录
SIPP_SCENARIO_DIR=../scenarios

# SIPp 注入文件目录（CSV 等）
SIPP_INJECTION_DIR=../injections

# SIPp 运行日志目录
SIPP_LOG_DIR=../logs

# TLS 证书目录（存放 .crt 和 .key 文件）
# 注意：系统支持从数据库动态读取证书，此目录用于存放默认证书或从数据库恢复的证书
SIPP_CERT_DIR=../certs

# ============================================
# 其他配置
# ============================================
# 会话超时时间（毫秒）
# SESSION_TIMEOUT=3600000

# WebSocket 心跳间隔（毫秒）
# WS_HEARTBEAT_INTERVAL=30000
