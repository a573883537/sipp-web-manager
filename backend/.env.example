# 服务器配置
PORT=3000
NODE_ENV=development

# SIPp配置
SIPP_PATH=sipp
SIPP_HOST=localhost
SIPP_CONTROL_PORT=8888
SIPP_CSV_PATH=/tmp/sipp_stats.csv
SIPP_SCENARIO_DIR=/home/wangjf/sipp/config/scenarios

# WebSocket配置
WS_PORT=3001
# 允许所有来源（开发环境），生产环境请指定具体域名
WS_CORS_ORIGIN=*

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# MySQL数据库配置（场景持久化存储）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sipp_manager
DB_USER=root
DB_PASSWORD=sipp123456
DB_POOL_SIZE=10
